{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workers-db",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_k586jp",
      "database_id": "173c36c0-690d-42ca-bfa8-7c171b5a5b0e"
    }
  ],
  "services": [
    {
      "binding": "MD2HTML",
      "service": "workers-markdown2html",
      "entrypoint": "Md2HtmlService"
    }
  ]
}